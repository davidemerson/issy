#!/usr/bin/expect -f
# t20_swap_recovery.exp -- swap-file lifecycle: autosave while dirty,
# survival across kill -9, foreign-swap protection on clean quit.

set timeout 12
set issy [lindex $argv 0]
set test_dir [lindex $argv 1]
source "$test_dir/helpers.tcl"

set tmpdir [exec mktemp -d]

# --- W1: dirty buffer writes a swap; it survives kill -9 with content ---
set f "$tmpdir/doc.txt"
set swp "$tmpdir/.doc.txt.swp"
exec printf "base\n" > $f
spawn $issy --no-config $f
sleep 0.8
send "UNSAVED "
# Swap autosave runs on the 1s tick, throttled to 2s intervals. Must
# drain (not sleep): the tick only runs while the editor isn't blocked
# writing to an unread pty.
drain 3.5
set ok 1
if {![file exists $swp]} {
    puts stderr "FAIL W1_swap_written (no $swp)"
    set ok 0
}
exec kill -9 [exp_pid]
expect eof
catch { wait }
if {$ok && ![file exists $swp]} {
    puts stderr "FAIL W1_swap_survives_kill (swap vanished)"
    set ok 0
}
if {$ok} {
    set got [read_file $swp]
    if {$got eq "UNSAVED base\n"} {
        puts stderr "PASS W1_swap_recovery_content"
    } else {
        puts stderr "FAIL W1_swap_recovery_content: [repr $got]"
        set ok 0
    }
}
record_result $ok

# --- W2: reopening reports the swap; a clean quit does NOT delete it ---
spawn $issy --no-config $f
sleep 0.8
send "\x11"
expect eof
wait
set ok 1
if {![file exists $swp]} {
    puts stderr "FAIL W2_foreign_swap_survives_clean_quit (deleted)"
    set ok 0
} else {
    puts stderr "PASS W2_foreign_swap_survives_clean_quit"
}
record_result $ok

# --- W3: once this session edits and saves, the swap is superseded and removed ---
spawn $issy --no-config $f
sleep 0.8
send "mine "
drain 3.5
send "\x13"
sleep 0.4
send "\x11"
expect eof
wait
set ok 1
if {[file exists $swp]} {
    puts stderr "FAIL W3_owned_swap_removed_on_save (still present)"
    set ok 0
} else {
    puts stderr "PASS W3_owned_swap_removed_on_save"
}
record_result [expr {$ok && [assert_file $f "mine base\n" "W3_save_content"]}]

exec rm -rf $tmpdir
report_results "t20_swap_recovery"
